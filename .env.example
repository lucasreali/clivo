# Where the browser sends API calls. Leave empty to use the same origin as the
# app, which is what the Vite dev proxy below serves. Only set this when the API
# is published on another origin that sends CORS headers and a cookie the
# browser will accept cross-site.
VITE_API_URL=

# Backend the dev server proxies /api to. Never reaches the browser.
API_PROXY_TARGET=http://localhost:8080
